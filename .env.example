# Database Configuration
DB_HOST=127.0.0.1
DB_NAME=chatbot_db
DB_USER=root
DB_PASS=

# Application Settings
APP_ENV=development
DEBUG_MODE=true
APP_URL=http://localhost/chatbot

# AI API Configuration
# Options: openai, anthropic, openrouter, custom
AI_PROVIDER=openai

# Your Secret API Key
AI_API_KEY=your-api-key-here

# Default Model
AI_MODEL=gpt-4o-mini
