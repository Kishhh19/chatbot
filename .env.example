# Database Configuration
DB_HOST=127.0.0.1
DB_NAME=chatbot_db
DB_USER=root
DB_PASS=

# Application Settings
APP_ENV=development
DEBUG_MODE=true
APP_URL=http://localhost/chatbot

# AI API Configuration
# Options: openai, anthropic, openrouter, custom
AI_PROVIDER=openai

# Your Secret API Key
AI_API_KEY=your-api-key-here

# Default Model
AI_MODEL=gpt-4o-mini

# Vercel server-only integrations (never expose these in browser JavaScript)
DIFY_API_KEY=dataset-your-rotated-dify-key
DIFY_DATASET_ID=45483dff-65bd-45e0-b5c2-79eaa7fe07c5
ORDER_SIGNING_SECRET=replace-with-a-long-random-secret
PAYMONGO_SECRET_KEY=sk_live_or_test_key_from_verified_merchant
PAYMONGO_PAYMENT_METHODS=gcash,paymaya,qrph,card
